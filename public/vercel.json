{
  "rewrites": [
    {
      "source": "/",
      "destination": "/traktat/scroll.html"
    }
  ],
  "headers": [
    {
      "source": "/traktat/scroll.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/traktat/formlaere.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
