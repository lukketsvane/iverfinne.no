{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "https://traktat.iverfinne.no/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "https://traktat.iverfinne.no/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://traktat.iverfinne.no/",
      "permanent": true
    },
    {
      "source": "/scroll",
      "destination": "https://traktat.iverfinne.no/",
      "permanent": true
    },
    {
      "source": "/scroll.html",
      "destination": "https://traktat.iverfinne.no/",
      "permanent": true
    }
  ]
}
